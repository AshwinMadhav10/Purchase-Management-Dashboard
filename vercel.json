{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "functions": {
    "backend/api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}